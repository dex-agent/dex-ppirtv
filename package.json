{
  "name": "dex-ppirtv",
  "version": "0.1.0",
  "description": "MCP stdio harness for PPIRTV flows with gates, meetings, evidence, verdicts and clean-house hygiene.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dex-ppirtv": "dist/index.js",
    "dex-ppirtv-launcher": "dist/launcher.js",
    "dex-ppirtv-memory-selector": "dist/memory-writer-selector-cutover-cli.js",
    "dex-ppirtv-memory-selector-probe": "dist/memory-writer-selector-activation-probe-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "audit:canonical": "node scripts/audit-canonical-sync.mjs",
    "check:flow-engine": "node scripts/validate-flow-engine-boundary.mjs",
    "diagnostic:bundle": "node scripts/export-diagnostic-bundle.mjs",
    "smoke:mcp-tools": "node scripts/smoke-mcp-tools.mjs",
    "memory-selector": "node dist/memory-writer-selector-cutover-cli.js",
    "memory-selector:probe": "node dist/memory-writer-selector-activation-probe-cli.js",
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run tests/e2e.test.ts",
    "check": "npm run audit:canonical && npm run check:flow-engine && npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "ppirtv",
    "harness"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=22"
  }
}
