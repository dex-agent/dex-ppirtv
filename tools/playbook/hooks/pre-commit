#!/bin/sh
# PLAYBOOK drift gate - blocks any commit while the projection is stale.
# Design: arena-zcode champion run-20261005-124942-s973103; owner GO 2026-10-05.
# Covers untracked local sources too (.agents/napkin.md) via sources_revision.

# issue 21 P1-2 (corte C): commit de RESOLUÇÃO de merge — nesse fluxo o git
# chama SÓ este hook (pre-merge-commit não roda); MERGE_HEAD presente no disco
# até o commit concluir é o detector. Delega ao merge-resolve-gate.sh, a MESMA
# fonte usada pelo pre-merge-commit A3f (git merge --continue): veredito único.
if [ -f "$GIT_DIR/MERGE_HEAD" ]; then
  "$(dirname "$0")/merge-resolve-gate.sh" || exit 1
fi

python -B tools/playbook/generate-playbook.py --repo . --check || exit 1

# PPIRTV-CAPACITY-COMMIT-GATE - capability-bearing changes require a fresh
# CAPACITY.md re-evaluation staged in the same commit.
node scripts/check-capacity.mjs --staged || exit 1

# PPIRTV-CRG-FRESH-GATE (GO do dono 2026-11-05: "nao depender da memoria — hook
# que cobra o gate pra seguir"): todo commit que toca codigo (src/tests/scripts)
# atualiza o banco estrutural CRG no mesmo instante — ninguem "esquece" porque o
# hook cura. BARATA MORTA 2026-11-05: `update --base HEAD` e NO-OP (diff
# HEAD..HEAD vazio) e o banco ficou preso em 339e3ca/agosto com receipts de
# falso verde — NUNCA passar --base HEAD aqui; a base default (last_built) e o
# incremental correto. Maquina sem a CLI (frota): aviso nao-bloqueante (o gate
# endurece onde a ferramenta existe; travar commit por falta de ferramenta e
# autossabotagem P10).
# CAUSA INCENDIARIA morta 2026-11-05 (pergunta do dono: "sintoma ou causa?"):
# o grep cobria so src/tests/scripts e o Trilho C (tools/) passou por fora —
# workflow/ (scripts do metodo) e tools/ (hooks/gates) tambem sao codigo que
# o CRG precisa enxergar.
if git diff --cached --name-only | grep -qE '^(src|tests|scripts|workflow|tools)/'; then
  if command -v code-review-graph >/dev/null 2>&1; then
    code-review-graph update --repo . --data-dir .agents/CODE-REVIEW-GRAPH -q \
      || { echo "CRG GATE FAIL: update incremental falhou (rode sem --base; confira .agents/CODE-REVIEW-GRAPH)"; exit 1; }
  else
    echo "CRG GATE (aviso): code-review-graph ausente no PATH — banco CRG nao conferido neste commit (frota: instale a CLI para o gate cheio)"
  fi
fi

# TOOLSBOOK fresh gate (R18 — dex-toolsbook; REAPARELHADO ao contrato
# dex.toolsbook.v2 em 2026-11-14, pagando a parte do repo da ISSUE-LOCAL-0010):
# commit que toca ferramenta (tools/|scripts/) exige o livro STRUCTURAL_FRESH
# (--check valida sources path->sha256 do working_tree). O gate valida o DISCO,
# não o staged: janela paralela que commita ferramenta com o livro do disco já
# atualizado não trava; o TOOLSBOOK.json viaja no commit do livro. Motor mora
# na skill (TOOLS-FAMILIA-REUSO-GLOBAL); frota sem o contrato v2 (--card ausente
# no --help) pula com aviso — travar commit por falta de ferramenta é
# autossabotagem (P10).
TOOLSBOOK_PY="${HOME:-$USERPROFILE}/.agents/skills/dex-toolsbook/scripts/toolsbook.py"
if [ -f "$TOOLSBOOK_PY" ] && python -B "$TOOLSBOOK_PY" --help 2>&1 | grep -q -- '--card'; then
  if git diff --cached --name-only | grep -qE '^(tools|scripts)/'; then
    # RAIZ (GO do dono 2026-11-14): fonte autorada e projeções moram na raiz
    # do repo — tools/TOOLSBOOK.json foi migrado para TOOLSBOOK.json.
    python -B "$TOOLSBOOK_PY" --repo . --check TOOLSBOOK.json || exit 1
  fi
else
  echo "TOOLSBOOK GATE (aviso): motor dex-toolsbook sem contrato v2 (--card) — livro por intenção não conferido neste commit (ISSUE-LOCAL-0010)"
fi

# DUPLICACAO-DELTA GATE (Trilho 2026-11-14-precommit-duplicacao-delta; receita da
# skill dex-complexidade-ciclomatica, dona do motor medir-duplicacao.py): commit que introduz/mantem
# duplicata Type-2 ENTRE arquivos .py e BLOQUEADO com as duas localizacoes
# (hash de AST normalizada — deterministico, nunca regex). O motor mora na skill
# global dex-complexidade-ciclomatica (R6: o repo nao copia); excecao legitima =
# tools/duplicacao-allowlist.json com motivo (R10). Frota sem a skill: aviso
# nao-bloqueante (P10 — travar commit por falta de ferramenta e autossabotagem).
if git diff --cached --name-only -- '*.py' | grep -q .; then
  python -B tools/check-duplicacao-delta.py --check || exit 1
fi
