#!/bin/sh
# PLAYBOOK drift gate - blocks any commit while the projection is stale.
# Design: arena-zcode champion run-20261005-124942-s973103; owner GO 2026-10-05.
# Covers untracked local sources too (.agents/napkin.md) via sources_revision.
python -B tools/playbook/generate-playbook.py --repo . --check || exit 1

# PPIRTV-CAPACITY-COMMIT-GATE - capability-bearing changes require a fresh
# CAPACITY.md re-evaluation staged in the same commit.
node scripts/check-capacity.mjs --staged || exit 1

# PPIRTV-CRG-FRESH-GATE (GO do dono 2026-11-05: "nao depender da memoria — hook
# que cobra o gate pra seguir"): todo commit que toca codigo (src/tests/scripts)
# atualiza o banco estrutural CRG no mesmo instante — ninguem "esquece" porque o
# hook cura. BARATA MORTA 2026-11-05: `update --base HEAD` e NO-OP (diff
# HEAD..HEAD vazio) e o banco ficou preso em 339e3ca/agosto com receipts de
# falso verde — NUNCA passar --base HEAD aqui; a base default (last_built) e o
# incremental correto. Maquina sem a CLI (frota): aviso nao-bloqueante (o gate
# endurece onde a ferramenta existe; travar commit por falta de ferramenta e
# autossabotagem P10).
# CAUSA INCENDIARIA morta 2026-11-05 (pergunta do dono: "sintoma ou causa?"):
# o grep cobria so src/tests/scripts e o Trilho C (tools/) passou por fora —
# workflow/ (scripts do metodo) e tools/ (hooks/gates) tambem sao codigo que
# o CRG precisa enxergar.
if git diff --cached --name-only | grep -qE '^(src|tests|scripts|workflow|tools)/'; then
  if command -v code-review-graph >/dev/null 2>&1; then
    code-review-graph update --repo . --data-dir .agents/CODE-REVIEW-GRAPH -q \
      || { echo "CRG GATE FAIL: update incremental falhou (rode sem --base; confira .agents/CODE-REVIEW-GRAPH)"; exit 1; }
  else
    echo "CRG GATE (aviso): code-review-graph ausente no PATH — banco CRG nao conferido neste commit (frota: instale a CLI para o gate cheio)"
  fi
fi

# TOOLSBOOK fresh gate (R18 — dex-toolsbook, instanciação 2026-11-13): o índice
# por INTENÇÃO (tools/TOOLSBOOK.md) não pode driftar das ferramentas do escopo
# (tools/ + scripts/). O motor mora na skill (padrão TOOLS-FAMILIA-REUSO-GLOBAL:
# o repo não copia os módulos); máquina de frota sem a skill pula com aviso —
# travar commit por falta de ferramenta é autossabotagem (P10).
TOOLSBOOK_PY="${HOME:-$USERPROFILE}/.agents/skills/dex-toolsbook/scripts/toolsbook.py"
if [ -f "$TOOLSBOOK_PY" ] && python -B "$TOOLSBOOK_PY" --help 2>&1 | grep -q -- '--dirs'; then
  python -B "$TOOLSBOOK_PY" --repo . --dirs tools,scripts --check || exit 1
else
  # ISSUE-LOCAL-0010 (2026-11-14): o motor da skill mudou de contrato fora do
  # repo (--gerar/--dirs/--check-frescor saíram); enquanto o gate não é
  # reaparelhado, aviso não-bloqueante (P10) — drift do índice é dívida
  # declarada no TRACKER, não motivo para travar commit.
  echo "TOOLSBOOK GATE (aviso): motor dex-toolsbook sem modo frescor (--dirs) — índice por intenção não conferido neste commit (ISSUE-LOCAL-0010)"
fi
